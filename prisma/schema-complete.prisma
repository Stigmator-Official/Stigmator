  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  @@index([date])
  @@index([createdAt])
  @@map("daily_stats")
}

model ProductAnalytics {
  id                String          @id @default(uuid())
  
  productId         String          @map("product_id")
  date              DateTime
  
  views             Int             @default(0)
  uniqueViews       Int             @default(0) @map("unique_views")
  addToCarts        Int             @default(0) @map("add_to_carts")
  
  sales             Int             @default(0)
  revenue           Int             @default(0)
  
  conversionRate    Float           @default(0) @map("conversion_rate")
  
  stockLevel        Int             @map("stock_level")
  
  viewsBySource     Json?           @map("views_by_source")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  @@unique([productId, date])
  @@index([productId])
  @@index([date])
  @@index([createdAt])
  @@map("product_analytics")
}

model UserAnalytics {
  id                String          @id @default(uuid())
  
  userId            String          @map("user_id")
  date              DateTime
  
  sessions          Int             @default(0)
  sessionDuration   Int             @default(0) @map("session_duration")
  
  pageViews         Int             @default(0) @map("page_views")
  productsViewed    Int             @default(0) @map("products_viewed")
  designsCreated    Int             @default(0) @map("designs_created")
  
  ordersPlaced      Int             @default(0) @map("orders_placed")
  amountSpent       Int             @default(0) @map("amount_spent")
  
  engagementScore   Int             @default(0) @map("engagement_score")
  
  lastDevice        String?         @map("last_device")
  lastLocation      String?         @map("last_location")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([engagementScore])
  @@map("user_analytics")
}

model AnalyticsEvent {
  id                String          @id @default(uuid())
  
  eventType         String          @map("event_type")
  eventName         String          @map("event_name")
  
  userId            String?         @map("user_id")
  sessionId         String?         @map("session_id")
  
  entityType        String?         @map("entity_type")
  entityId          String?         @map("entity_id")
  
  properties        Json?
  
  url               String?
  referrer          String?
  userAgent         String?         @map("user_agent")
  ipAddress         String?         @map("ip_address")
  deviceType        String?         @map("device_type")
  country           String?
  
  createdAt         DateTime        @default(now()) @map("created_at")
  
  @@index([eventType])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([sessionId])
  @@map("analytics_events")
}

// ============================================
// ADMIN & PERMISSIONS
// ============================================

model Permission {
  id                String          @id @default(uuid())
  
  name              String          @unique
  description       String?
  resource          String
  action            String
  
  conditions        Json?
  
  rolePermissions   RolePermission[]
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  id                String          @id @default(uuid())
  
  role              UserRole
  
  permissionId      String          @map("permission_id")
  permission        Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  scope             Json?
  
  createdAt         DateTime        @default(now()) @map("created_at")
  
  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
  @@map("role_permissions")
}

model AdminAction {
  id                String          @id @default(uuid())
  
  adminId           String          @map("admin_id")
  admin             User            @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  actionType        AdminActionType @map("action_type")
  action            String
  
  targetType        String          @map("target_type")
  targetId          String          @map("target_id")
  targetData        Json?           @map("target_data")
  
  ipAddress         String?         @map("ip_address")
  userAgent         String?         @map("user_agent")
  
  reason            String?         @db.Text
  
  isReverted        Boolean         @default(false) @map("is_reverted")
  revertedById      String?         @map("reverted_by_id")
  revertedAt        DateTime?       @map("reverted_at")
  revertReason      String?         @map("revert_reason")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  
  @@index([adminId])
  @@index([actionType])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_actions")
}

// ============================================
// COMPETITIONS
// ============================================

model Competition {
  id              String            @id @default(uuid())
  
  title           String
  description     String            @db.Text
  type            CompetitionType
  theme           String
  
  status          CompetitionStatus @default(DRAFT)
  
  submissionStart DateTime
  submissionEnd   DateTime
  votingStart     DateTime?
  votingEnd       DateTime?
  
  prizePool       Int
  prizeBreakdown  Json
  
  maxEntriesPerArtist Int           @default(3)
  
  entryCount      Int               @default(0)
  voteCount       Int               @default(0)
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  entries         CompetitionEntry[]
  
  @@map("competitions")
}

model CompetitionEntry {
  id              String      @id @default(uuid())
  
  competitionId   String
  competition     Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  
  designId        String
  design          Design      @relation(fields: [designId], references: [id], onDelete: Cascade)
  artistId        String
  
  entryTitle      String
  description     String?     @db.Text
  
  voteCount       Int         @default(0)
  finalRank       Int?
  
  prizeAmount     Int?
  prizePaid       Boolean     @default(false)
  
  createdAt       DateTime    @default(now())
  
  votes           CompetitionVote[]
  
  @@unique([competitionId, designId])
  @@map("competition_entries")
}

model CompetitionVote {
  id              String           @id @default(uuid())
  
  entryId         String
  entry           CompetitionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime         @default(now())
  
  @@unique([entryId, userId])
  @@map("competition_votes")
}

// ============================================
// REVIEWS
// ============================================

model Review {
  id              String    @id @default(uuid())
  
  customerId      String
  customer        User      @relation(fields: [customerId], references: [id])
  
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  
  rating          Int
  title           String?
  content         String    @db.Text
  
  images          String[]
  
  isVerifiedPurchase Boolean @default(false)
  isPublic        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([productId])
  @@index([customerId])
  @@map("reviews")
}

// ============================================
// WEBHOOKS & API
// ============================================

model Webhook {
  id                String          @id @default(uuid())
  
  name              String
  description       String?
  
  url               String
  secret            String
  
  events            WebhookEvent[]
  
  isActive          Boolean         @default(true) @map("is_active")
  
  retryCount        Int             @default(3) @map("retry_count")
  timeoutMs         Int             @default(30000) @map("timeout_ms")
  
  headers           Json?
  
  metadata          Json?
  
  createdById       String?         @map("created_by_id")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  deliveries        WebhookDelivery[]
  
  @@index([isActive])
  @@index([createdAt])
  @@map("webhooks")
}

model WebhookDelivery {
  id                String          @id @default(uuid())
  
  webhookId         String          @map("webhook_id")
  webhook           Webhook         @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  
  eventType         WebhookEvent    @map("event_type")
  payload           Json
  
  requestHeaders    Json?           @map("request_headers")
  requestBody       String?         @map("request_body") @db.Text
  responseStatus    Int?            @map("response_status")
  responseHeaders   Json?           @map("response_headers")
  responseBody      String?         @map("response_body") @db.Text
  
  durationMs        Int?            @map("duration_ms")
  
  status            String
  attemptNumber     Int             @default(1) @map("attempt_number")
  maxAttempts       Int             @default(3) @map("max_attempts")
  
  errorMessage      String?         @map("error_message")
  
  nextRetryAt       DateTime?       @map("next_retry_at")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  completedAt       DateTime?       @map("completed_at")
  
  @@index([webhookId])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

model ApiKey {
  id                String          @id @default(uuid())
  
  name              String
  keyHash           String          @unique @map("key_hash")
  keyPrefix         String          @map("key_prefix")
  
  createdById       String          @map("created_by_id")
  createdBy         User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  
  permissions       ApiPermission[]
  
  allowedIps        String[]        @map("allowed_ips")
  allowedRoutes     String[]        @map("allowed_routes")
  
  rateLimitTier     String          @default("default") @map("rate_limit_tier")
  
  lastUsedAt        DateTime?       @map("last_used_at")
  usageCount        Int             @default(0) @map("usage_count")
  
  isActive          Boolean         @default(true) @map("is_active")
  revokedAt         DateTime?       @map("revoked_at")
  revokedReason     String?         @map("revoked_reason")
  
  expiresAt         DateTime?       @map("expires_at")
  
  metadata          Json?
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  usageLogs         ApiKeyUsage[]
  
  @@index([createdById])
  @@index([isActive])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("api_keys")
}

model ApiKeyUsage {
  id                String          @id @default(uuid())
  
  apiKeyId          String          @map("api_key_id")
  apiKey            ApiKey          @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  
  method            String
  path              String
  statusCode        Int             @map("status_code")
  
  durationMs        Int             @map("duration_ms")
  
  ipAddress         String?         @map("ip_address")
  userAgent         String?         @map("user_agent")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  
  @@index([apiKeyId])
  @@index([createdAt])
  @@map("api_key_usage")
}

// ============================================
