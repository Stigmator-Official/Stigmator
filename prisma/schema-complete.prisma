}

// ============================================
// AUDIT & COMPLIANCE
// ============================================

model AuditLog {
  id                String          @id @default(uuid())
  
  userId            String?         @map("user_id")
  userType          String          @default("SYSTEM") @map("user_type")
  apiKeyId          String?         @map("api_key_id")
  
  action            String
  resource          String
  resourceId        String?         @map("resource_id")
  
  changes           Json?
  metadata          Json?
  
  ipAddress         String?         @map("ip_address")
  userAgent         String?         @map("user_agent")
  requestId         String?         @map("request_id")
  sessionId         String?         @map("session_id")
  
  success           Boolean         @default(true)
  errorMessage      String?         @map("error_message")
  
  dataSensitivity   String?         @map("data_sensitivity")
  retentionUntil    DateTime?       @map("retention_until")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([ipAddress])
  @@map("audit_logs")
}

model DataExport {
  id                String          @id @default(uuid())
  
  name              String
  description       String?
  
  requestedById     String          @map("requested_by_id")
  
  entityTypes       String[]        @map("entity_types")
  filters           Json?
  dateRangeStart    DateTime?       @map("date_range_start")
  dateRangeEnd      DateTime?       @map("date_range_end")
  
  status            String
  progress          Int             @default(0)
  
  fileUrl           String?         @map("file_url")
  fileSize          Int?            @map("file_size")
  fileFormat        String?         @map("file_format")
  recordCount       Int?            @map("record_count")
  
  expiresAt         DateTime?       @map("expires_at")
  
  completedAt       DateTime?       @map("completed_at")
  errorMessage      String?         @map("error_message")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  @@index([requestedById])
  @@index([status])
  @@index([createdAt])
  @@map("data_exports")
}

