// ============================================================================
// STIGMATOR - COMPLETE ENTERPRISE DATABASE SCHEMA
// Production-grade Prisma schema with complete type safety
// ============================================================================

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS - Type Safety at Database Level
// ============================================

enum UserRole {
  CUSTOMER
  ARTIST
  ADMIN
  SUPER_ADMIN
  DEVELOPER
  FULFILLMENT
  STUDIO_MANAGER
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum DesignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

enum GarmentType {
  TSHIRT
  LONG_SLEEVE
  HOODIE
  TANK_TOP
  CREWNECK
  HAT_BEANIE
  HAT_TRUCKER
  POSTER
  STICKER_PACK
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  PAUSED
  SOLD_OUT
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_RECEIVED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum OrderLifecycleStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  APPLE_PAY
  GOOGLE_PAY
  KLARNA
  AFFIRM
  BANK_TRANSFER
  CRYPTO
  GIFT_CARD
}

enum ShippingStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURN_TO_SENDER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
  BUNDLE_DISCOUNT
}

enum ProductVisibility {
  DRAFT
  HIDDEN
  VISIBLE
  FEATURED
  EXCLUSIVE
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  BACKORDER
  DISCONTINUED
  PREORDER
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  HELD_FOR_REVIEW
}

enum PartnershipCodeStatus {
  GENERATED
  SENT
  REDEEMED
  EXPIRED
  REVOKED
}

enum PartnershipStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum CompetitionStatus {
  DRAFT
  OPEN
  CLOSED
  VOTING
  COMPLETED
  CANCELLED
}

enum CompetitionType {
  MONTHLY
  BRACKET
  FLASH_BATTLE
  COLLAB_CHALLENGE
}

enum WebhookEvent {
  ORDER_CREATED
  ORDER_UPDATED
  ORDER_CANCELLED
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  USER_REGISTERED
  USER_UPDATED
  REFUND_PROCESSED
  INVENTORY_LOW
  REVIEW_SUBMITTED
  PARTNERSHIP_REDEEMED
}

enum AdminActionType {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_BANNED
  USER_UNBANNED
  PRODUCT_APPROVED
  PRODUCT_REJECTED
  PRODUCT_FEATURED
  ORDER_REFUNDED
  ORDER_CANCELLED
  PAYOUT_PROCESSED
  PAYOUT_HELD
  PROMO_CODE_CREATED
  PROMO_CODE_DELETED
  SETTINGS_UPDATED
  WEBHOOK_CREATED
  WEBHOOK_DELETED
  API_KEY_CREATED
  API_KEY_REVOKED
  DATA_EXPORTED
  MASS_EMAIL_SENT
}

enum ApiPermission {
  READ_PRODUCTS
  WRITE_PRODUCTS
  READ_ORDERS
  WRITE_ORDERS
  READ_USERS
  WRITE_USERS
  READ_ANALYTICS
  READ_INVENTORY
  WRITE_INVENTORY
  READ_WEBHOOKS
  WRITE_WEBHOOKS
  ADMIN_ACCESS
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  emailVerified     Boolean   @default(false)
  
  // Profile
  fullName          String?
  displayName       String?   @unique
  avatarUrl         String?
  bio               String?   @db.Text
  location          String?
  website           String?
  instagramHandle   String?
  
  // Role & Verification
  role              UserRole  @default(CUSTOMER)
  isVerified        Boolean   @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt        DateTime?
  
  // Security
  passwordHash      String?
  twoFactorEnabled  Boolean   @default(false)
  lastLoginAt       DateTime?
  
  // Marketing
  referralCode      String?   @unique
  referredById      String?
  referredBy        User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals         User[]    @relation("UserReferrals")
  
  // Notification preferences
  emailNotifications Boolean @default(true)
  marketingEmails   Boolean   @default(false)
  
  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // Soft delete

  // Relations
  artistProfile     ArtistProfile?
  studioMemberships StudioMember[]
  designs           Design[]
  products          Product[]
  artistProductDesigns ProductDesign[] @relation("ArtistProductDesigns")
  artistDesignPartnerships DesignPartnership[] @relation("ArtistDesignPartnerships")
  artistGarmentDesigns GarmentDesign[] @relation("ArtistGarmentDesigns")
  partnershipCodes  PartnershipCode[]
  partnerships      Partnership[]
  orders            Order[]
  reviews           Review[]
  votes             CompetitionVote[]
  payouts           Payout[]
  activityLogs      ActivityLog[]
  designPartnerships DesignPartnership[] @relation("PartnerDesignPartnerships")
  earningsBreakdowns EarningsBreakdown[] @relation("RecipientEarnings")
  referralsMade     Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("ReferredArtist")
  mockupPresets     MockupPreset[]
  designFiles       DesignFile[]
  
  // Admin & Enterprise
  adminActions      AdminAction[]
  apiKeys           ApiKey[]
  
  @@index([email])
  @@index([role])
  @@index([referralCode])
  @@index([referredById])
  @@map("users")
}

// ============================================
// ARTIST PROFILES
// ============================================

model ArtistProfile {
  id                String    @id @default(uuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Professional Info
  yearsExperience   Int?
  specialties       String[]  // Array of tattoo styles
  portfolioUrl      String?
  
  // Application Data
  applicationData   Json?     // Store the full application
  reviewedById      String?
  reviewedAt        DateTime?
  rejectionReason   String?   @db.Text
  
  // Stats (denormalized for performance)
  totalDesigns      Int       @default(0)
  totalSales        Int       @default(0)
  totalEarnings     Int       @default(0) // in cents
  rating            Float     @default(0)
  reviewCount       Int       @default(0)
  
  // Settings
  defaultSplits     Json?     // Default artist/client/studio split percentages
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("artist_profiles")
}

// ============================================
// STUDIOS
// ============================================

model Studio {
  id                  String           @id @default(uuid())
  slug                String           @unique
  
  // Basic Info
  name                String
  description         String?          @db.Text
  logoUrl             String?
  bannerUrl           String?
  
  // Location
  address             String?
  city                String?
  state               String?
  country             String?
  postalCode          String?
  latitude            Float?
  longitude           Float?
  
  // Contact
  phone               String?
  email               String?
  website             String?
  instagramHandle     String?
  
  // Verification
  verificationStatus  VerificationStatus @default(PENDING)
  verificationDocs    Json?              // Store verification documents
  verifiedAt          DateTime?
  
  // Stats
  artistCount         Int              @default(0)
  totalSales          Int              @default(0)
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  // Relations
  members             StudioMember[]
  products            Product[]
  designPartnerships  DesignPartnership[]
  
  @@index([verificationStatus])
  @@index([slug])
  @@map("studios")
}

model StudioMember {
  id        String   @id @default(uuid())
  studioId  String
  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // OWNER, MANAGER, ARTIST
  
  createdAt DateTime @default(now())
  
  @@unique([studioId, userId])
  @@map("studio_members")
}

// ============================================
// DESIGNS
// ============================================

model Design {
  id              String        @id @default(uuid())
  
  // Ownership
  artistId        String
  artist          User          @relation(fields: [artistId], references: [id])
  
  // Content
  title           String
  description     String?       @db.Text
  
  // Assets
  originalFile    String        // High-res original
  previewImage    String        // Web-optimized preview
  thumbnailImage  String        // Small thumbnail
  
  // Metadata
  status          DesignStatus  @default(DRAFT)
  category        String?       // tattoo style
  tags            String[]
  isNSFW          Boolean       @default(false)
  
  // Attribution
  attributionRequired Boolean   @default(false)
  
  // Stats
  viewCount       Int           @default(0)
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  publishedAt     DateTime?

  // Relations
  products        ProductDesign[]
  partnershipCodes PartnershipCode[]
  designPartnerships DesignPartnership[]
  garmentDesigns  GarmentDesign[]
  earningsBreakdowns EarningsBreakdown[]
  competitionEntries CompetitionEntry[]
  
  @@index([artistId])
  @@index([status])
  @@index([category])
  @@index([tags])
  @@map("designs")
}

// ============================================
// PRODUCTS (GARMENTS)
// ============================================

model Product {
  id              String        @id @default(uuid())
  
  // Ownership
  artistId        String
  artist          User          @relation(fields: [artistId], references: [id])
  studioId        String?
  studio          Studio?       @relation(fields: [studioId], references: [id])
  
  // Product Info
  name            String
  description     String?       @db.Text
  garmentType     GarmentType
  
  // Status
  status          ProductStatus @default(DRAFT)
  visibility      ProductVisibility @default(DRAFT)
  
  // Pricing
  basePrice       Int           // in cents
  salePrice       Int?          // for promotions
  costToProduce   Int           // manufacturing cost
  
  // Deposit & Recoup System
  depositAmount   Int           // in cents
  depositRecoupEnabled Boolean  @default(false)
  depositRecoupTargetSales Int  @default(0)
  depositRecoupedAmount Int     @default(0)
  depositRecoupedSalesCount Int @default(0)
  
  // Freshness Algorithm
  freshnessScore  Int           @default(0)
  lastSaleAt      DateTime?
  
  // Inventory
  inventoryEnabled Boolean      @default(false)
  inventoryCount  Int           @default(0)
  
  // Stats
  totalSales      Int           @default(0)
  totalRevenue    Int           @default(0) // in cents
  
  // SEO & Metadata
  metaTitle       String?
  metaDescription String?
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  publishedAt     DateTime?

  // Relations
  designs         ProductDesign[]
  reviews         Review[]
  variants        ProductVariant[]
  inventory       Inventory?
  collections     CollectionProduct[]
  
  @@index([artistId])
  @@index([status])
  @@index([garmentType])
  @@index([freshnessScore])
  @@index([visibility])
  @@map("products")
}

// Junction table: Products can have multiple designs (collaborations)
model ProductDesign {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  designId        String
  design          Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  artistId        String
  artist          User     @relation("ArtistProductDesigns", fields: [artistId], references: [id], onDelete: Cascade)
  
  // Positioning data
  positionX       Float    @default(0) @map("position_x")
  positionY       Float    @default(0) @map("position_y")
  scale           Float    @default(1)
  rotation        Float    @default(0)
  
  // Alternative JSON placement (for SQL compatibility)
  designPlacement Json?    @map("design_placement")
  
  // Revenue share for this design on this product
  revenueShare    Int      @default(100) @map("revenue_share")
  
  // Mockup
  mockupImages    String[] @map("mockup_images")
  mockupImage     String?  // Legacy single mockup
  printFile       String?  // Production-ready print file
  
  // Pricing & deposits
  priceOverride   Int?     @map("price_override")
  depositAmount   Int      @default(0) @map("deposit_amount")
  
  // Status
  isActive        Boolean  @default(true) @map("is_active")
  totalSales      Int      @default(0) @map("total_sales")
  
  // Manufacturing workflow
  productionStatus String? @default("draft") @map("production_status")
  manufacturerId  String?  @map("manufacturer_id")
  mockupDeliveryMethod String? @default("digital") @map("mockup_delivery_method")
  artistRetailPrice Int?   @map("artist_retail_price")
  suggestedRetailPrice Int? @map("suggested_retail_price")
  manufacturingCost Int?   @map("manufacturing_cost")
  platformFeeAmount Int?   @map("platform_fee_amount")
  artistProfitPerUnit Int? @map("artist_profit_per_unit")
  isLimitedRun    Boolean  @default(false) @map("is_limited_run")
  maxUnits        Int?     @map("max_units")
  unitsSold       Int      @default(0) @map("units_sold")
  unitsReserved   Int      @default(0) @map("units_reserved")
  isCampaignMode  Boolean  @default(false) @map("is_campaign_mode")
  campaignMinUnits Int     @default(10) @map("campaign_min_units")
  campaignEndsAt  DateTime? @map("campaign_ends_at")
  
  // Deposit recoup
  depositRecoupEnabled Boolean @default(false) @map("deposit_recoup_enabled")
  depositRecoupSalesTarget Int? @map("deposit_recoup_sales_target")
  depositRecoupedSalesCount Int @default(0) @map("deposit_recouped_sales_count")
  depositRecoupedAt DateTime? @map("deposit_recouped_at")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  // Relations
  orderItems      OrderItem[]
  garmentDesigns  GarmentDesign[]
  garmentDesignPartnerships GarmentDesignPartnership[]
  depositRecoupPayments DepositRecoupPayment[]
  manufacturingAttempts ManufacturingAttempt[]
  manufacturingQuotes ManufacturingQuote[]
  productionQueueItems ProductionQueue[]
  
  @@unique([productId, designId])
  @@map("product_designs")
}

// ============================================
// PRODUCT VARIANTS & INVENTORY
// ============================================

model ProductVariant {
  id                String          @id @default(uuid())
  
  productId         String          @map("product_id")
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sku               String          @unique
  barcode           String?         @unique
  
  size              String?
  color             String?
  colorHex          String?         @map("color_hex")
  material          String?
  
  priceOverride     Int?            @map("price_override")
  
  weight            Float?
  dimensions        Json?
  
  isActive          Boolean         @default(true) @map("is_active")
  images            String[]
  metadata          Json?
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  inventory         Inventory?
  orderItems        OrderItem[]
  
  @@index([productId])
  @@index([sku])
  @@index([isActive])
  @@map("product_variants")
}

model Inventory {
  id                String          @id @default(uuid())
  
  productId         String?         @unique @map("product_id")
  product           Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  variantId         String?         @unique @map("variant_id")
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  quantityInStock   Int             @default(0) @map("quantity_in_stock")
  quantityReserved  Int             @default(0) @map("quantity_reserved")
  quantityAvailable Int             @default(0) @map("quantity_available")
  
  lowStockThreshold Int             @default(10) @map("low_stock_threshold")
  reorderPoint      Int?            @map("reorder_point")
  reorderQuantity   Int?            @map("reorder_quantity")
  
  status            InventoryStatus @default(IN_STOCK)
  
  lastRestockedAt   DateTime?       @map("last_restocked_at")
  nextRestockDate   DateTime?       @map("next_restock_date")
  
  warehouseLocation String?         @map("warehouse_location")
  binLocation       String?         @map("bin_location")
  
  history           InventoryHistory[]
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  @@index([status])
  @@index([productId])
  @@index([variantId])
  @@map("inventory")
}

model InventoryHistory {
  id                String          @id @default(uuid())
  
  inventoryId       String          @map("inventory_id")
  inventory         Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  
  quantityChange    Int             @map("quantity_change")
  quantityAfter     Int             @map("quantity_after")
  
  reason            String
  referenceId       String?         @map("reference_id")
  referenceType     String?         @map("reference_type")
  
  createdById       String?         @map("created_by_id")
  notes             String?         @db.Text
  
  createdAt         DateTime        @default(now()) @map("created_at")
  
  @@index([inventoryId])
  @@index([reason])
  @@index([createdAt])
  @@map("inventory_history")
}

// ============================================
// PRODUCT COLLECTIONS
// ============================================

model ProductCollection {
  id                String          @id @default(uuid())
  
  name              String
  slug              String          @unique
  description       String?         @db.Text
  
  imageUrl          String?         @map("image_url")
  bannerUrl         String?         @map("banner_url")
  
  isActive          Boolean         @default(true) @map("is_active")
  visibility        ProductVisibility @default(VISIBLE)
  
  metaTitle         String?         @map("meta_title")
  metaDescription   String?         @map("meta_description")
  
  sortOrder         Int             @default(0) @map("sort_order")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  products          CollectionProduct[]
  
  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("product_collections")
}

model CollectionProduct {
  id                String          @id @default(uuid())
  
  collectionId      String          @map("collection_id")
  collection        ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  productId         String          @map("product_id")
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sortOrder         Int             @default(0) @map("sort_order")
  addedAt           DateTime        @default(now()) @map("added_at")
  
  @@unique([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
  @@map("collection_products")
}

// ============================================
// PARTNERSHIP SYSTEM (EQUITY INK)
// ============================================

model PartnershipCode {
  id                String                @id @default(uuid())
  code              String                @unique
  
  artistId          String
  artist            User                  @relation(fields: [artistId], references: [id])
  designId          String
  design            Design                @relation(fields: [designId], references: [id])
  
  artistShare       Int
  partnerShare      Int
  studioShare       Int
  
  status            PartnershipCodeStatus @default(GENERATED)
  
  expiresAt         DateTime?
  
  requiresPhoto     Boolean               @default(true)
  requiresLocation  Boolean               @default(true)
  
  designPartnerships DesignPartnership[]
  partnership       Partnership?
  
  createdAt         DateTime              @default(now())
  redeemedAt        DateTime?

  @@index([code])
  @@index([artistId])
  @@index([designId])
  @@index([status])
  @@map("partnership_codes")
}

model Partnership {
  id                String             @id @default(uuid())
  
  codeId            String             @unique
  code              PartnershipCode    @relation(fields: [codeId], references: [id])
  partnerId         String
  partner           User               @relation(fields: [partnerId], references: [id])
  
  artistShare       Int
  partnerShare      Int
  studioShare       Int
  
  status            PartnershipStatus  @default(PENDING_VERIFICATION)
  verificationPhoto String?
  verificationLocation Json?
  verifiedAt        DateTime?
  
  totalSales        Int                @default(0)
  totalEarnings     Int                @default(0)
  
  partnerNotified   Boolean            @default(false)
  
  createdAt         DateTime           @default(now())
  activatedAt       DateTime?
  
  transactions      PartnershipTransaction[]
  
  @@index([partnerId])
  @@index([status])
  @@map("partnerships")
}

model PartnershipTransaction {
  id              String      @id @default(uuid())
  partnershipId   String
  partnership     Partnership @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem   @relation(fields: [orderItemId], references: [id])
  
  amount          Int
  
  createdAt       DateTime    @default(now())
  
  @@map("partnership_transactions")
}

// ============================================
// ORDERS
// ============================================

model Order {
  id              String      @id @default(uuid())
  
  customerId      String      @map("customer_id")
  customer        User        @relation(fields: [customerId], references: [id])
  
  customerEmail   String?     @map("customer_email")
  customerName    String?     @map("customer_name")
  
  status          OrderStatus @default(PENDING_PAYMENT)
  
  subtotal        Int
  taxAmount       Int         @map("tax_amount")
  shippingAmount  Int         @map("shipping_amount")
  discountAmount  Int         @map("discount_amount")
  total           Int
  currency        String      @default("USD")
  
  stripePaymentIntentId String?
  stripeChargeId  String?
  
  shippingAddress Json?
  shippingMethod  String?
  trackingNumber  String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  paidAt          DateTime?

  items           OrderItem[]
  
  // Enterprise additions
  promoCodeId     String?     @map("promo_code_id")
  promoCode       PromoCode?  @relation(fields: [promoCodeId], references: [id])
  payment         Payment?
  shipping        Shipping?
  notes           OrderNote[]
  activities      OrderActivity[]
  
  @@index([customerId])
  @@index([status])
  @@index([stripePaymentIntentId])
  @@index([promoCodeId])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productDesignId String   @map("product_design_id")
  productDesign   ProductDesign @relation(fields: [productDesignId], references: [id])
  
  productName     String
  designTitle     String
  artistName      String
  artistId        String
  mockupImage     String
  
  size            String
  color           String
  
  unitPrice       Int      @map("unit_price")
  quantity        Int
  totalPrice      Int      @map("total_price")
  
  hasPartnership  Boolean  @default(false)
  
  productionStatus String  @default("PENDING") @map("production_status")
  printFileUrl    String? @map("print_file_url")
  
  // Fulfillment
  fulfillmentPartnerId String? @map("fulfillment_partner_id")
  fulfillmentStatus String? @default("unassigned") @map("fulfillment_status")
  fulfillmentNotes  String? @map("fulfillment_notes")
  
  createdAt       DateTime @default(now()) @map("created_at")

  partnershipTransactions PartnershipTransaction[]
  payoutItems     PayoutItem[]
  earningsBreakdowns EarningsBreakdown[]
  depositRecoupPayments DepositRecoupPayment[]
  referralEarnings ReferralEarning[]
  
  // Enterprise additions
  variantId       String?         @map("variant_id")
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  
  @@index([productDesignId])
  @@index([variantId])
  @@map("order_items")
}

// ============================================
// PAYMENT SYSTEM
// ============================================

model Payment {
  id                String          @id @default(uuid())
  
  orderId           String          @unique @map("order_id")
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  stripePaymentIntentId String?     @unique @map("stripe_payment_intent_id")
  stripeChargeId    String?         @unique @map("stripe_charge_id")
  stripeCustomerId  String?         @map("stripe_customer_id")
  stripeRefundId    String?         @map("stripe_refund_id")
  
  amount            Int
  currency          String          @default("USD")
  status            PaymentStatus   @default(PENDING)
  method            PaymentMethod?
  
  amountAuthorized  Int             @default(0) @map("amount_authorized")
  amountCaptured    Int             @default(0) @map("amount_captured")
  amountRefunded    Int             @default(0) @map("amount_refunded")
  
  cardLast4         String?         @map("card_last4")
  cardBrand         String?         @map("card_brand")
  cardExpiryMonth   Int?            @map("card_expiry_month")
  cardExpiryYear    Int?            @map("card_expiry_year")
  
  billingAddress    Json?           @map("billing_address")
  
  failureCode       String?         @map("failure_code")
  failureMessage    String?         @map("failure_message")
  
  receiptUrl        String?         @map("receipt_url")
  receiptEmail      String?         @map("receipt_email")
  
  authorizedAt      DateTime?       @map("authorized_at")
  capturedAt        DateTime?       @map("captured_at")
  refundedAt        DateTime?       @map("refunded_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  refunds           Refund[]
  
  @@index([status])
  @@index([stripePaymentIntentId])
  @@index([stripeChargeId])
  @@index([createdAt])
  @@map("payments")
}

model Refund {
  id                String          @id @default(uuid())
  
  paymentId         String          @map("payment_id")
  payment           Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  stripeRefundId    String          @unique @map("stripe_refund_id")
  
  amount            Int
  reason            String?
  status            String
  
  processedById     String?         @map("processed_by_id")
  notes             String?         @db.Text
  
  orderId           String          @map("order_id")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  
  @@index([paymentId])
  @@index([orderId])
  @@index([createdAt])
  @@map("refunds")
}

// ============================================
// SHIPPING SYSTEM
// ============================================

model Shipping {
  id                String          @id @default(uuid())
  
  orderId           String          @unique
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  carrier           String
  service           String
  
  trackingNumber    String?         @map("tracking_number")
  trackingUrl       String?         @map("tracking_url")
  
  recipientName     String          @map("recipient_name")
  addressLine1      String          @map("address_line1")
  addressLine2      String?         @map("address_line2")
  city              String
  state             String
  country           String          @default("US")
  postalCode        String          @map("postal_code")
  phone             String?
  
  cost              Int
  insuranceAmount   Int?            @map("insurance_amount")
  
  packageWeight     Float?          @map("package_weight")
  packageDimensions Json?           @map("package_dimensions")
  
  status            ShippingStatus  @default(PENDING)
  
  labelCreatedAt    DateTime?       @map("label_created_at")
  shippedAt         DateTime?       @map("shipped_at")
  estimatedDelivery DateTime?       @map("estimated_delivery")
  deliveredAt       DateTime?       @map("delivered_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  trackingEvents    ShippingEvent[]
  
  @@index([status])
  @@index([trackingNumber])
  @@index([carrier])
  @@index([createdAt])
  @@map("shipping")
}

model ShippingEvent {
  id                String          @id @default(uuid())
  
  shippingId        String          @map("shipping_id")
  shipping          Shipping        @relation(fields: [shippingId], references: [id], onDelete: Cascade)
  
  status            String
  description       String
  location          String?
  
  occurredAt        DateTime        @map("occurred_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  
  @@index([shippingId])
  @@index([occurredAt])
  @@map("shipping_events")
}

// ============================================
// ORDER ENHANCEMENTS
// ============================================

model OrderNote {
  id                String          @id @default(uuid())
  
  orderId           String          @map("order_id")
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  content           String          @db.Text
  isInternal        Boolean         @default(true) @map("is_internal")
  
  createdById       String?         @map("created_by_id")
  createdByType     String          @default("SYSTEM") @map("created_by_type")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  @@index([orderId])
  @@index([createdAt])
  @@map("order_notes")
}

model OrderActivity {
  id                String          @id @default(uuid())
  
  orderId           String          @map("order_id")
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  status            OrderLifecycleStatus
  description       String
  
  actorId           String?         @map("actor_id")
  actorType         String          @default("SYSTEM") @map("actor_type")
  
  metadata          Json?
  
  createdAt         DateTime        @default(now()) @map("created_at")
  
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("order_activities")
}

// ============================================
// PAYOUTS
// ============================================

model Payout {
  id              String        @id @default(uuid())
  
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  
  periodStart     DateTime
  periodEnd       DateTime
  
  grossAmount     Int
  platformFees    Int
  taxWithheld     Int
  netAmount       Int
  
  status          PayoutStatus  @default(PENDING)
  
  stripeTransferId String?
  
  processedAt     DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  
  createdAt       DateTime      @default(now())

  items           PayoutItem[]
  earningsBreakdowns EarningsBreakdown[]
  
  @@index([userId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@map("payouts")
}

model PayoutItem {
  id              String    @id @default(uuid())
  payoutId        String
  payout          Payout    @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  
  orderItemId     String
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id])
  
  grossAmount     Int
  platformFee     Int
  netAmount       Int
  
  type            String
  
  createdAt       DateTime  @default(now())
  
  @@map("payout_items")
}

// ============================================
// PROMO CODE SYSTEM
// ============================================

model PromoCode {
  id                String          @id @default(uuid())
  
  code              String          @unique
  name              String
  description       String?         @db.Text
  
  type              DiscountType
  value             Int
  minimumOrderAmount Int?           @map("minimum_order_amount")
  maximumDiscount   Int?            @map("maximum_discount")
  
  usageLimit        Int?            @map("usage_limit")
  usageLimitPerUser Int?            @map("usage_limit_per_user")
  usageCount        Int             @default(0) @map("usage_count")
  
  startsAt          DateTime?       @map("starts_at")
  expiresAt         DateTime?       @map("expires_at")
  
  applicableProducts String[]       @map("applicable_products")
  excludedProducts  String[]        @map("excluded_products")
  applicableCategories String[]     @map("applicable_categories")
  newCustomersOnly  Boolean         @default(false) @map("new_customers_only")
  
  isActive          Boolean         @default(true) @map("is_active")
  
  metadata          Json?
  
  createdById       String?         @map("created_by_id")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  
  usages            CodeUsage[]
  orders            Order[]
  
  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("promo_codes")
}

model CodeUsage {
  id                String          @id @default(uuid())
  
  promoCodeId       String          @map("promo_code_id")
  promoCode         PromoCode       @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  
  userId            String          @map("user_id")
  orderId           String          @map("order_id")
  
  discountAmount    Int             @map("discount_amount")
  
  ipAddress         String?         @map("ip_address")
  
  createdAt         DateTime        @default(now()) @map("created_at")
  
  @@unique([promoCodeId, userId, orderId])
  @@index([promoCodeId])
  @@index([userId])
  @@index([orderId])
  @@index([createdAt])
  @@map("code_usages")
}

// ============================================
// ANALYTICS SYSTEM
