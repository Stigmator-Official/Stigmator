// ============================================
// MOCKUP SYSTEM (from schema_mockups.sql)
// ============================================

model MockupPreset {
  id              String   @id @default(uuid())
  artistId        String   @map("artist_id")
  artist          User     @relation(fields: [artistId], references: [id], onDelete: Cascade)
  
  name            String
  description     String?
  tags            String[]
  
  garmentType     String   @map("garment_type")
  variantId       String   @map("variant_id")
  colorHex        String   @map("color_hex")
  fabricType      String   @default("cotton") @map("fabric_type")
  
  designTransform Json?    @map("design_transform")
  printArea       String   @default("chest") @map("print_area")
  
  cameraAngle     Json?    @map("camera_angle")
  lightingPreset  String   @default("studio") @map("lighting_preset")
  
  thumbnailUrl    String?  @map("thumbnail_url")
  previewUrls     Json?    @map("preview_urls")
  
  isDefault       Boolean  @default(false) @map("is_default")
  isPublic        Boolean  @default(false) @map("is_public")
  usageCount      Int      @default(0) @map("usage_count")
  lastUsedAt      DateTime? @map("last_used_at")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  renders         MockupRender[]
  
  @@index([artistId])
  @@index([garmentType])
  @@map("mockup_presets")
}

model MockupRender {
  id              String   @id @default(uuid())
  presetId        String   @map("preset_id")
  preset          MockupPreset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  
  angle           String
  width           Int
  height          Int
  format          String
  
  storagePath     String   @map("storage_path")
  publicUrl       String   @map("public_url")
  fileSizeBytes   Int?     @map("file_size_bytes")
  
  isPrimary       Boolean  @default(false) @map("is_primary")
  generationTimeMs Int?    @map("generation_time_ms")
  
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@index([presetId])
  @@map("mockup_renders")
}

model DesignFile {
  id              String   @id @default(uuid())
  artistId        String   @map("artist_id")
  artist          User     @relation(fields: [artistId], references: [id], onDelete: Cascade)
  
  originalName    String   @map("original_name")
  storagePath     String   @map("storage_path")
  publicUrl       String   @map("public_url")
  
  format          String
  width           Int
  height          Int
  hasTransparency Boolean  @default(false) @map("has_transparency")
  fileSizeBytes   Int      @map("file_size_bytes")
  
  dominantColors  Json?    @map("dominant_colors")
  isDarkDesign    Boolean? @map("is_dark_design")
  
  usageCount      Int      @default(0) @map("usage_count")
  lastUsedAt      DateTime? @map("last_used_at")
  
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@index([artistId])
  @@map("design_files")
}

model GarmentModel {
  id              String   @id @default(uuid())
  
  type            String
  variantId       String   @map("variant_id")
  name            String
  
  modelUrl        String   @map("model_url")
  textureUrl      String?  @map("texture_url")
  
  polygonCount    Int?     @map("polygon_count")
  hasLods         Boolean  @default(false) @map("has_lods")
  fileSizeBytes   Int?     @map("file_size_bytes")
  
  // Print areas as JSON: [{ "name": "chest", "uv_coords": [...] }]
  printAreas      Json?    @map("print_areas")
  
  isActive        Boolean  @default(true) @map("is_active")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  @@map("garment_models")
}

// ============================================
// MANUFACTURING WORKFLOW (from schema_manufacturing_workflow.sql)
// ============================================

model ManufacturingAttempt {
  id              String   @id @default(uuid())
  productDesignId String   @map("product_design_id")
  productDesign   ProductDesign @relation(fields: [productDesignId], references: [id])
  manufacturerId  String   @map("manufacturer_id")
  
  status          String // pending, approved, declined, withdrawn
  declineReason   String? @map("decline_reason")
  
  submittedAt     DateTime @default(now()) @map("submitted_at")
  respondedAt     DateTime? @map("responded_at")
  
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@map("manufacturing_attempts")
}

model ManufacturingQuote {
  id              String   @id @default(uuid())
  productDesignId String   @map("product_design_id")
  productDesign   ProductDesign @relation(fields: [productDesignId], references: [id])
  manufacturerId  String   @map("manufacturer_id")
  
  costPerUnit     Int      @map("cost_per_unit")
  minOrderQuantity Int     @default(1) @map("min_order_quantity")
  setupFee        Int      @default(0) @map("setup_fee")
  shippingEstimate Int?    @map("shipping_estimate")
  turnaroundDays  Int?     @map("turnaround_days")
  
  isAccepted      Boolean  @default(false) @map("is_accepted")
  acceptedAt      DateTime? @map("accepted_at")
  
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@map("manufacturing_quotes")
}

model ProductionQueue {
  id              String   @id @default(uuid())
  productDesignId String   @map("product_design_id")
  productDesign   ProductDesign @relation(fields: [productDesignId], references: [id])
  manufacturerId  String   @map("manufacturer_id")
  
  status          String // queued, in_production, quality_check, completed, shipped
  quantity        Int
  priority        Int      @default(0)
  
  estimatedStart  DateTime? @map("estimated_start")
  estimatedCompletion DateTime? @map("estimated_completion")
  actualStart     DateTime? @map("actual_start")
  actualCompletion DateTime? @map("actual_completion")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  @@map("production_queue")
}

// ============================================
// REFERRAL SYSTEM (from schema_referrals.sql)
// ============================================

model Referral {
  id                  String   @id @default(uuid())
  referrerId          String   @map("referrer_id")
  referrer            User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredArtistId    String   @map("referred_artist_id")
  referredArtist      User     @relation("ReferredArtist", fields: [referredArtistId], references: [id], onDelete: Cascade)
  
  referralCode        String   @unique @map("referral_code")
  status              String   @default("pending") // pending, completed, expired
  
  commissionRate      Decimal  @default(0.05) @db.Decimal(5, 4) @map("commission_rate")
  commissionDurationMonths Int @default(6) @map("commission_duration_months")
  
  totalSalesGenerated Int      @default(0) @map("total_sales_generated")
  totalCommissionPaid Int      @default(0) @map("total_commission_paid")
  
  createdAt           DateTime @default(now()) @map("created_at")
  artistApprovedAt    DateTime? @map("artist_approved_at")
  expiresAt           DateTime? @map("expires_at")
  
  earnings            ReferralEarning[]
  
  @@unique([referredArtistId])
  @@index([referrerId])
  @@map("referrals")
}

model ReferralEarning {
  id              String   @id @default(uuid())
  referralId      String   @map("referral_id")
  referral        Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  orderItemId     String   @map("order_item_id")
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  
  saleAmount      Int      @map("sale_amount")
  commissionAmount Int     @map("commission_amount")
  
  status          String   @default("pending") // pending, paid, cancelled
  paidAt          DateTime? @map("paid_at")
  
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@unique([orderItemId])
  @@index([referralId])
  @@map("referral_earnings")
}

// ============================================
// ENHANCED PARTNERSHIPS (from schema_enhanced_partnerships.sql)
// ============================================

model DesignPartnership {
  id                  String   @id @default(uuid())
  partnershipCodeId   String   @map("partnership_code_id")
  code                PartnershipCode @relation(fields: [partnershipCodeId], references: [id])
  designId            String   @map("design_id")
  design              Design   @relation(fields: [designId], references: [id])
  artistId            String   @map("artist_id")
  artist              User     @relation("ArtistDesignPartnerships", fields: [artistId], references: [id])
  partnerId           String   @map("partner_id")
  partner             User     @relation("PartnerDesignPartnerships", fields: [partnerId], references: [id])
  studioId            String?  @map("studio_id")
  studio              Studio?  @relation(fields: [studioId], references: [id])
  
  artistShare         Int      @map("artist_share")
  clientShare         Int      @map("client_share")
  studioShare         Int      @map("studio_share")
  
  verificationStatus  String   @default("pending") @map("verification_status") // pending, verified, rejected
  verificationPhotoUrl String? @map("verification_photo_url")
  verifiedAt          DateTime? @map("verified_at")
  verifiedById        String?  @map("verified_by")
  
  totalEarnings       Int      @default(0) @map("total_earnings")
  lifetimeSales       Int      @default(0) @map("lifetime_sales")
  
  createdAt           DateTime @default(now()) @map("created_at")
  
  garmentPartnerships GarmentDesignPartnership[]
  
  @@unique([designId, partnerId])
  @@index([partnerId])
  @@index([designId])
  @@map("design_partnerships")
}

model GarmentDesignPartnership {
  id                  String   @id @default(uuid())
  productDesignId     String   @map("product_design_id")
  productDesign       ProductDesign @relation(fields: [productDesignId], references: [id])
  designPartnershipId String   @map("design_partnership_id")
  designPartnership   DesignPartnership @relation(fields: [designPartnershipId], references: [id])
  
  artistShare         Int      @map("artist_share")
  clientShare         Int      @map("client_share")
  studioShare         Int      @map("studio_share")
  
  totalGarmentEarnings Int     @default(0) @map("total_garment_earnings")
  
  createdAt           DateTime @default(now()) @map("created_at")
  
  @@unique([productDesignId, designPartnershipId])
  @@map("garment_design_partnerships")
}

model EarningsBreakdown {
  id              String   @id @default(uuid())
  orderItemId     String   @map("order_item_id")
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id])
  
  saleAmount      Int      @map("sale_amount")
  platformFee     Int      @map("platform_fee")
  remainingAmount Int      @map("remaining_amount")
  
  recipientId     String   @map("recipient_id")
  recipient       User     @relation("RecipientEarnings", fields: [recipientId], references: [id])
  recipientType   String   @map("recipient_type") // artist, client, studio, platform
  
  amount          Int
  percentage      Decimal  @db.Decimal(5, 2)
  
  designId        String?  @map("design_id")
  design          Design?  @relation(fields: [designId], references: [id])
  
  paid            Boolean  @default(false)
  paidAt          DateTime? @map("paid_at")
  payoutId        String?  @map("payout_id")
  payout          Payout?  @relation(fields: [payoutId], references: [id])
  
  createdAt       DateTime @default(now()) @map("created_at")
  
  @@index([recipientId])
  @@index([orderItemId])
  @@map("earnings_breakdown")
}

model GarmentDesign {
  id                  String   @id @default(uuid())
  productDesignId     String   @map("product_design_id")
  productDesign       ProductDesign @relation(fields: [productDesignId], references: [id])
  designId            String   @map("design_id")
  design              Design   @relation(fields: [designId], references: [id])
  artistId            String   @map("artist_id")
  artist              User     @relation("ArtistGarmentDesigns", fields: [artistId], references: [id])
  
  placementArea       String?  @map("placement_area")
  placementOrder      Int      @default(0) @map("placement_order")
  revenuePercentage   Decimal  @default(100.00) @db.Decimal(5, 2) @map("revenue_percentage")
  
  createdAt           DateTime @default(now()) @map("created_at")
  
  @@unique([productDesignId, designId])
  @@index([productDesignId])
  @@map("garment_designs")
}

// ============================================
// DEPOSIT RECOUP (from schema_deposit_recoup.sql)
// ============================================

model DepositRecoupPayment {
  id                  String   @id @default(uuid())
  productDesignId     String   @map("product_design_id")
  productDesign       ProductDesign @relation(fields: [productDesignId], references: [id])
  orderItemId         String   @map("order_item_id")
  orderItem           OrderItem @relation(fields: [orderItemId], references: [id])
  
  amount              Int
  cumulativeRecouped  Int      @map("cumulative_recouped")
  remainingToRecoup   Int      @map("remaining_to_recoup")
  
  createdAt           DateTime @default(now()) @map("created_at")
  
  @@index([productDesignId])
  @@map("deposit_recoup_payments")
}
